{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerOps exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "key",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "type",
          "data"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "companies",
              "job_postings",
              "schedules",
              "applications",
              "profile",
              "rules",
              "exclusions",
              "analysis_facts",
              "assessments",
              "career_records"
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/priorRow"
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "priorRow": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
